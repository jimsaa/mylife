# =============================================================================
# My Life — environment variables
# =============================================================================
#
# Vercel (production — required for /admin password gate)
# ------------------------------------------------------------
# ADMIN_SESSION_SECRET=generate-a-long-random-string
# ADMIN_TEMP_PASSWORD=life7394
#
# Self-hosted API (server/)
# -------------------------
# PORT=3001
# HOST=0.0.0.0
# NODE_ENV=production
# MY_LIFE_CLIENT_PORT=3006
# ADMIN_SESSION_SECRET=generate-a-long-random-string
# ADMIN_TEMP_PASSWORD=life7394
#
# Digital Legacy
# --------------
# OWNER_EMAIL=you@example.com
# PUBLIC_BASE_URL=https://jimsaari.se
# LEGACY_TOKEN_SECRET=generate-a-long-random-string
# LEGACY_CRON_SECRET=generate-a-long-random-string
# LEGACY_SCHEDULER=1
# EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=My Life <noreply@yourdomain.com>
#
# Optional AI sleep import (stored in SQLite settings table, not env):
#   openai_api_key — configure via PUT /api/stats/settings/openai_api_key
