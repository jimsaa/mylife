{
  "name": "my-life",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first personal productivity and life management application",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix client",
    "preview": "npm run preview --prefix client",
    "migrate": "npm run migrate --prefix server",
    "seed": "npm run seed --prefix server",
    "test:samsung-sleep": "npm run test:samsung-sleep --prefix server",
    "setup": "npm install && npm install --prefix client && npm install --prefix server && npm run migrate && npm run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
