# =============================================================================
# My Life — environment variables
# =============================================================================
#
# Vercel (frontend only)
# ----------------------
# No environment variables are required for the public landing page or static SPA.
#
# Optional: proxy API requests to a self-hosted backend (set in Vercel project
# settings and update vercel.json rewrites destination accordingly):
#   API_ORIGIN=https://your-api-host.example.com
#
# Self-hosted API (server/)
# -------------------------
# PORT=3001
# HOST=0.0.0.0
# NODE_ENV=production
# MY_LIFE_CLIENT_PORT=3006
#
# Optional AI sleep import (stored in SQLite settings table, not env):
#   openai_api_key — configure via PUT /api/stats/settings/openai_api_key
