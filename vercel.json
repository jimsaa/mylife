{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm install --prefix client",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/auth/session.ts": {
      "includeFiles": "data/hpb-season-2026-27.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/hpb-bets",
      "destination": "/api/auth/session?resource=hpb-bets"
    },
    {
      "source": "/api/hpb-bets/:betNumber",
      "destination": "/api/auth/session?resource=hpb-bets&betNumber=:betNumber"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
